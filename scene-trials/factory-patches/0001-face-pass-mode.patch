+class PipelinePlumbingTests(unittest.TestCase):
+    def _line(self, root: Path, calls: list[dict[str, object]], **overrides: object) -> Pipeline:
+        def run(**kwargs: object) -> dict[str, object]:
+            calls.append(kwargs)
+            return _planned()
+
+        return Pipeline(_settings(root, **overrides), run_job=run)
+
+    def _accept(self, root: Path, line: Pipeline) -> dict[str, object]:
+        gen = root / "gen"
+        gen.mkdir(exist_ok=True)
+        write_rgb_png(gen / "x.png", 8, 8, parameters=_info("1girl, anal sex"))
+        row = line.accept(gen / "x.png")
+        assert row is not None
+        return row
+
+    def test_default_is_required(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            calls: list[dict[str, object]] = []
+            line = self._line(Path(tmp), calls)
+            self._accept(Path(tmp), line)
+            line.paint_available(1)
+            main = [c for c in calls if c.get("preset_ids") == ["anal"]]
+            self.assertEqual(main[0]["face_pass"], "required")
+
+    def test_a_row_value_beats_the_setting(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            calls: list[dict[str, object]] = []
+            line = self._line(Path(tmp), calls, face_pass="optional")
+            row = self._accept(Path(tmp), line)
+            line._merge(str(row["sha256"]), {"face_pass": "skip"})
+            line.paint_available(1)
+            self.assertEqual([c["face_pass"] for c in calls if c.get("preset_ids") == ["anal"]], ["skip"])
+
+    def test_the_setting_applies_without_a_row_value(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            calls: list[dict[str, object]] = []
+            line = self._line(Path(tmp), calls, face_pass="optional")
+            self._accept(Path(tmp), line)
+            line.paint_available(1)
+            self.assertEqual([c["face_pass"] for c in calls if c.get("preset_ids") == ["anal"]], ["optional"])
+
+    def test_config_file_reads_and_validates_face_pass(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            block = '"enabled": true, "inbox": "i", "sorted": "s", "output": "o"'
+            good = root / "good.json"
+            good.write_text('{"pipeline": {%s, "face_pass": "skip"}}' % block, encoding="utf-8")
+            settings = load_settings(good, PRESETS)
+            assert settings is not None
+            self.assertEqual(settings.face_pass, "skip")
+            plain = root / "plain.json"
+            plain.write_text('{"pipeline": {%s}}' % block, encoding="utf-8")
+            default = load_settings(plain, PRESETS)
+            assert default is not None
+            self.assertEqual(default.face_pass, "required")
+            bad = root / "bad.json"
+            bad.write_text('{"pipeline": {%s, "face_pass": "maybe"}}' % block, encoding="utf-8")
+            with self.assertRaises(DiffSetError):
+                load_settings(bad, PRESETS)
