index 0000000..769cd7f
--- /dev/null
+++ b/sd-diff-set/tests/test_face_pass.py
@@ -0,0 +1,362 @@
+"""face_pass modes and the ``none`` stage filter. No GPU, no WebUI, no YOLO."""
+
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from sd_diff_set.errors import DiffSetError
+from sd_diff_set.executor import GenerationHost, InpaintJob
+from sd_diff_set.factory_line import run_factory
+from sd_diff_set.pattern_set import PATTERN_IDS
+from sd_diff_set.pipeline import Pipeline, PipelineSettings, load_settings
+from sd_diff_set.png_text import read_parameters, upsert_parameters, write_rgb_png
+from sd_diff_set.service import run_job
+
+PRESETS = Path(__file__).resolve().parents[1] / "presets"
+WEIGHTS = (
+    "face_yolov8n.pt",
+    "hand_yolov8n.pt",
+    "foot_yolov8x_v2.pt",
+    "nsfw-anime-medium-x1280.pt",
+)
+SIZE = 64
+ANAL_STAGES = ("imminent", "tip", "hilt")
+
+
+def _info(prompt: str) -> str:
+    return "\n".join(
+        [
+            prompt,
+            "Negative prompt: lowres",
+            "Steps: 20, Sampler: Euler a, Schedule type: Automatic, CFG scale: 7, Seed: 1, "
+            f"Size: {SIZE}x{SIZE}, Model hash: abcd1234, Model: demoMix_v1, VAE: vaeFt, Clip skip: 2",
+        ]
+    )
+
+
+class _Host(GenerationHost):
+    def __init__(self) -> None:
+        self.jobs: list[InpaintJob] = []
+
+    def inpaint(self, job: InpaintJob) -> None:
+        self.jobs.append(job)
+        job.dest.write_bytes(job.init_path.read_bytes())
+        upsert_parameters(job.dest, job.parameters_text)
+
+    def face_passes(self) -> int:
+        return sum(job.dest.name.endswith(".face.png") for job in self.jobs)
+
+
+def _regions(_image: Path, _model: Path) -> list[tuple[str, tuple[float, float, float, float]]]:
+    return [("anus", (20, 20, 30, 30)), ("penis", (24, 8, 34, 22)), ("female face", (4, 4, 16, 16))]
+
+
+class _Fixture(unittest.TestCase):
+    def setUp(self) -> None:
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.root = Path(self._tmp.name)
+        weights = self.root / "weights"
+        weights.mkdir()
+        for name in WEIGHTS:
+            (weights / name).write_bytes(b"")
+        env = mock.patch.dict(os.environ, {"SD_DIFF_WEIGHTS_DIR": str(weights)})
+        env.start()
+        self.addCleanup(env.stop)
+        regions = mock.patch("sd_diff_set.regions._predict_regions", _regions)
+        regions.start()
+        self.addCleanup(regions.stop)
+        self.face_error: str | None = None
+        self.face_calls = 0
+        patcher = mock.patch("sd_diff_set.executor.detect_mask", self._detect)
+        patcher.start()
+        self.addCleanup(patcher.stop)
+        self.base = self.root / "base.png"
+        write_rgb_png(self.base, SIZE, SIZE, parameters=_info("1girl, solo, anal sex"))
+
+    def _detect(self, _image: Path, _model: str, dest: Path) -> Path:
+        self.face_calls += 1
+        if self.face_error:
+            raise DiffSetError(self.face_error, "no face")
+        write_rgb_png(dest, SIZE, SIZE, rgb=(255, 255, 255))
+        return dest
+
+    def run_anal(self, **kwargs: object) -> tuple[dict[str, object], _Host]:
+        host = _Host()
+        payload = run_job(
+            base_path=self.base,
+            preset_dir=PRESETS,
+            preset_ids=["anal"],
+            output_dir=self.root / "out",
+            adult_ok=True,
+            use_controlnet=False,
+            dry_run=False,
+            overwrite=True,
+            host=host,
+            stages=ANAL_STAGES,
+            **kwargs,  # type: ignore[arg-type]
+        )
+        return payload, host
+
+    @staticmethod
+    def items(payload: dict[str, object]) -> dict[str, dict[str, object]]:
+        rows = payload["items"]
+        assert isinstance(rows, list)
+        return {str(row["variant"]): row for row in rows}
