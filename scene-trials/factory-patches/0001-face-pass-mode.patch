+class FactoryJobTests(unittest.TestCase):
+    @staticmethod
+    def _job(**extra: object) -> dict[str, object]:
+        job: dict[str, object] = {
+            "id": "stand",
+            "prompt": "1girl, solo, anal sex",
+            "negative_prompt": "lowres",
+            "sampler_name": "Euler a",
+            "steps": 28,
+            "cfg_scale": 6,
+            "width": 1024,
+            "height": 1344,
+            "model": "demoMix_v1",
+        }
+        job.update(extra)
+        return job
+
+    def _run(self, root: Path, job: dict[str, object], calls: list[dict[str, object]]) -> dict[str, object]:
+        image = root / "poster.png"
+        write_rgb_png(image, 8, 8)
+        raw = image.read_bytes()
+
+        def run(**kwargs: object) -> dict[str, object]:
+            calls.append(kwargs)
+            return _planned()
+
+        return run_factory(
+            settings=_settings(root, dry_run=False, limbs=False),
+            jobs=[job],
+            poster=lambda _api, _payload: raw,
+            dry_run=False,
+            once=True,
+            run_job=run,
+        )
+
+    def test_job_keys_reach_the_paint_call(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            calls: list[dict[str, object]] = []
+            payload = self._run(Path(tmp), self._job(stages=["imminent", "tip"], face_pass="skip"), calls)
+            self.assertEqual(payload["jobs"][0]["status"], "ok")  # type: ignore[index]
+            self.assertEqual(calls[0]["face_pass"], "skip")
+            self.assertEqual(calls[0]["stages"], ("imminent", "tip"))
+            params = read_parameters(Path(tmp) / "inbox" / "stand.png")
+            self.assertIn("anal sex", str(params))
+
+    def test_none_reaches_the_paint_call_as_the_no_stage_sentinel(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            calls: list[dict[str, object]] = []
+            self._run(Path(tmp), self._job(stages=["none"]), calls)
+            self.assertEqual(calls[0]["stages"], ("none",))
+            self.assertEqual(calls[0]["face_pass"], "required")
+
+    def test_a_bad_value_is_refused_before_posting(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            calls: list[dict[str, object]] = []
+
+            def poster(_api: str, _payload: dict[str, object]) -> bytes:
+                raise AssertionError("must not post")
+
+            payload = run_factory(
+                settings=_settings(Path(tmp), dry_run=False),
+                jobs=[self._job(face_pass="maybe")],
+                poster=poster,
+                dry_run=False,
+                once=True,
+                run_job=lambda **kwargs: calls.append(kwargs) or _planned(),
+            )
+            row = payload["jobs"][0]  # type: ignore[index]
+            self.assertEqual((row["status"], row["error_code"]), ("error", "bad_face_pass"))
+            self.assertEqual(calls, [])
