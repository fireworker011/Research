+    def _working_copy(self, placed: Path, repaired: Path, category: str) -> Path:
+        """Carry the repaired pixels to the diffs under the base's own name.
+
+        The repaired file keeps its limb mask and its limb prompt next to it. Using it directly would
+        rename the diff folder, add hand and foot tags to every stage prompt, and let the limb mask pass
+        for a hand-drawn mask. The copy has the base's name and parameters, and the base's hand-drawn masks.
+        """
+        folder = self.settings.output_dir / "limbs" / category / "work"
+        folder.mkdir(parents=True, exist_ok=True)
+        working = folder / placed.name
+        shutil.copyfile(repaired, working)
+        upsert_parameters(working, read_parameters(placed) or "")
+        self._copy_masks(placed, working)
+        self._cut_file(working)
+        return working
+
