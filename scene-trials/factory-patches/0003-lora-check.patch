diff --git a/sd-diff-set/sd_diff_set/lora_check.py b/sd-diff-set/sd_diff_set/lora_check.py
new file mode 100644
index 0000000..23d3850
--- /dev/null
+++ b/sd-diff-set/sd_diff_set/lora_check.py
@@ -0,0 +1,85 @@
+"""Find out whether the LoRA tags in a job prompt can work, and whether they did.
+
+The factory sends the job prompt to the WebUI unchanged. The WebUI drops a ``<lora:name:weight>`` tag whose
+name it does not know, without an error, so a missing file looks like "the LoRA has no effect". Two checks
+make that visible: the names the WebUI lists at ``/sdapi/v1/loras``, and the ``Lora hashes`` the WebUI writes
+into the picture it returns.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import urllib.request
+
+LORA_CHECK_MODES = ("error", "warn", "off")
+_TAG = re.compile(r"<(?:lora|lyco):([^:>]+)(?::[^>]*)?>", re.IGNORECASE)
+_HASHES = re.compile(r'Lora hashes:\s*"([^"]*)"')
+_INFOTEXT_MARK = re.compile(r"\bSteps:\s*\d+")
+
+
+def lora_names(prompt: str) -> list[str]:
+    """Names in ``<lora:...>`` and ``<lyco:...>`` tags, in order, without repeats."""
+    seen: list[str] = []
+    for match in _TAG.finditer(prompt):
+        name = match.group(1).strip()
+        if name and name not in seen:
+            seen.append(name)
+    return seen
+
+
+def listed_names(rows: list[dict[str, object]]) -> set[str]:
+    """Every name and alias a ``/sdapi/v1/loras`` answer offers."""
+    found: set[str] = set()
+    for row in rows:
+        for key in ("name", "alias"):
+            value = row.get(key)
+            if isinstance(value, str) and value.strip():
+                found.add(value.strip())
+    return found
+
+
+def missing_loras(names: list[str], rows: list[dict[str, object]]) -> list[str]:
+    """Tag names the WebUI does not list. A name that differs only in case is still missing, with a hint."""
+    available = listed_names(rows)
+    folded = {name.casefold(): name for name in available}
+    missing: list[str] = []
+    for name in names:
+        if name in available:
+            continue
+        near = folded.get(name.casefold())
+        missing.append(f"{name} (the WebUI has {near!r}; the case differs)" if near else name)
+    return missing
+
+
+def applied_loras(parameters: str | None) -> set[str] | None:
+    """Names the WebUI says it applied, read from the returned picture's infotext.
+
+    None means the picture carries no usable infotext, so nothing can be said.
+    """
+    if not parameters or not _INFOTEXT_MARK.search(parameters):
+        return None
+    match = _HASHES.search(parameters)
+    if match is None:
+        return set()
+    return {part.split(":", 1)[0].strip() for part in match.group(1).split(",") if part.strip()}
+
+
+def not_applied(asked: list[str], applied: set[str] | None) -> list[str]:
+    if applied is None:
+        return []
+    have = {name.casefold() for name in applied}
+    return [name for name in asked if name.casefold() not in have]
+
+
+def probe_loras(api_base: str, timeout: float = 5.0) -> list[dict[str, object]] | None:
+    """GET ``/sdapi/v1/loras``. None when the host cannot answer, so the check is skipped."""
+    request = urllib.request.Request(api_base.rstrip("/") + "/sdapi/v1/loras")
+    try:
+        with urllib.request.urlopen(request, timeout=timeout) as response:
+            payload = json.loads(response.read().decode("utf-8"))
+    except Exception:
+        return None
+    if not isinstance(payload, list):
+        return None
+    return [row for row in payload if isinstance(row, dict)]
diff --git a/sd-diff-set/tests/test_lora_check.py b/sd-diff-set/tests/test_lora_check.py
new file mode 100644
index 0000000..2980a64
--- /dev/null
+++ b/sd-diff-set/tests/test_lora_check.py
@@ -0,0 +1,186 @@
+"""LoRA tag checks before and after txt2img. No GPU, no WebUI, no network."""
+
+from __future__ import annotations
+
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from sd_diff_set.errors import DiffSetError
+from sd_diff_set.factory_line import run_factory
+from sd_diff_set.lora_check import applied_loras, listed_names, lora_names, missing_loras, not_applied
+from sd_diff_set.pipeline import PipelineSettings
+from sd_diff_set.png_text import write_rgb_png
+
+PRESETS = Path(__file__).resolve().parents[1] / "presets"
+PROMPT = "1girl, <lora:caststyle_xl_epoch08:0.9>, <lora:nieva_xl:0.8>, <lyco:extra:1>, simple background"
+INFOTEXT = "1girl\nNegative prompt: lowres\nSteps: 20, Sampler: Euler a, CFG scale: 7, Seed: 1, Size: 8x8, Model: m"
+KNOWN = [{"name": "caststyle_xl_epoch08", "alias": "caststyle"}, {"name": "nieva_xl"}, {"name": "extra"}]
+
+
+class HelperTests(unittest.TestCase):
+    def test_names_in_order_without_repeats(self) -> None:
+        text = "<lora:a:0.5>, x, <LORA:b>, <lora:a:0.9>, <lyco:c:1.0>, <lora: d :1>"
+        self.assertEqual(lora_names(text), ["a", "b", "c", "d"])
+        self.assertEqual(lora_names("no tags, (lora:1.2)"), [])
+
+    def test_missing_uses_names_and_aliases_and_hints_a_case_mismatch(self) -> None:
+        rows = [{"name": "nieva_xl", "alias": "nieva"}, {"name": "Case_Only"}, {"name": None}]
+        self.assertEqual(listed_names(rows), {"nieva_xl", "nieva", "Case_Only"})
+        self.assertEqual(missing_loras(["nieva_xl", "nieva"], rows), [])
+        got = missing_loras(["case_only", "gone"], rows)
+        self.assertIn("gone", got)
+        self.assertTrue(any(item.startswith("case_only (the WebUI has 'Case_Only'") for item in got))
+
+    def test_applied_reads_the_hashes_of_the_returned_picture(self) -> None:
+        self.assertIsNone(applied_loras(None))
+        self.assertIsNone(applied_loras("no infotext here"))
+        self.assertEqual(applied_loras(INFOTEXT), set())
+        with_hashes = INFOTEXT + ', Lora hashes: "caststyle_xl_epoch08: 1a2b3c, nieva_xl: 4d5e6f", Version: x'
+        self.assertEqual(applied_loras(with_hashes), {"caststyle_xl_epoch08", "nieva_xl"})
+        self.assertEqual(not_applied(["nieva_xl", "Extra"], {"nieva_xl"}), ["Extra"])
+        self.assertEqual(not_applied(["nieva_xl"], None), [])
+
+
+def _settings(root: Path) -> PipelineSettings:
+    return PipelineSettings(
+        inbox=root / "inbox",
+        sorted_dir=root / "sorted",
+        output_dir=root / "diffs",
+        preset_dir=PRESETS,
+        adult_ok=True,
+        dry_run=False,
+        limbs=False,
+    )
+
+
+def _job(**extra: object) -> dict[str, object]:
+    job: dict[str, object] = {
+        "id": "pic",
+        "prompt": PROMPT,
+        "negative_prompt": "lowres",
+        "sampler_name": "Euler a",
+        "steps": 28,
+        "cfg_scale": 6,
+        "width": 1024,
+        "height": 1344,
+        "model": "m",
+        "stages": ["none"],
+    }
+    job.update(extra)
+    return job
+
+
+class FactoryLoraTests(unittest.TestCase):
+    def _run(self, root: Path, *, rows, mode: str = "error", job=None, dry_run: bool = False, parameters: str | None = None):
+        posted: list[dict[str, object]] = []
+        probed: list[str] = []
+        image = root / "ret.png"
+        write_rgb_png(image, 8, 8, parameters=parameters)
+        data = image.read_bytes()
+
+        def poster(_api: str, payload: dict[str, object]) -> bytes:
+            posted.append(payload)
+            return data
+
+        def probe(api: str):
+            probed.append(api)
+            return rows
+
+        painted: list[object] = []
+        result = run_factory(
+            settings=_settings(root),
+            jobs=[job or _job()],
+            poster=poster,
+            dry_run=dry_run,
+            once=True,
+            run_job=lambda **kwargs: painted.append(1) or {"status": "ok", "items": [], "dry_run": False},
+            loras_probe=probe,
+            lora_check=mode,
+        )
+        return result, posted, probed, painted
+
+    def test_an_unknown_lora_stops_the_job_before_posting(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            result, posted, probed, painted = self._run(Path(tmp), rows=[{"name": "nieva_xl"}])
+            row = result["jobs"][0]  # type: ignore[index]
+            self.assertEqual((row["status"], row["error_code"]), ("error", "lora_missing"))
+            self.assertIn("caststyle_xl_epoch08", row["error"])
+            self.assertIn("extra", row["error"])
+            self.assertNotIn("nieva_xl", row["error"].split("ます: ")[-1])
+            self.assertEqual((posted, painted), ([], []))
+            self.assertEqual(len(probed), 1)
+
+    def test_known_loras_by_name_or_alias_are_posted_unchanged(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            rows = [{"name": "caststyle", "alias": "caststyle_xl_epoch08"}, {"name": "nieva_xl"}, {"alias": "extra"}]
+            result, posted, _probed, _painted = self._run(Path(tmp), rows=rows, parameters=INFOTEXT)
+            self.assertEqual(result["jobs"][0]["status"], "ok")  # type: ignore[index]
+            self.assertEqual(posted[0]["prompt"], PROMPT)
+
+    def test_warn_posts_and_reports(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            result, posted, _probed, _painted = self._run(Path(tmp), rows=[], mode="warn")
+            row = result["jobs"][0]  # type: ignore[index]
+            self.assertEqual(row["status"], "ok")
+            self.assertEqual(len(posted), 1)
+            self.assertEqual(sum(note.startswith("lora_missing") for note in row["warnings"]), 3)
+
+    def test_off_and_dry_run_do_not_probe(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            _result, posted, probed, _painted = self._run(Path(tmp), rows=[], mode="off")
+            self.assertEqual((len(posted), probed), (1, []))
+        with tempfile.TemporaryDirectory() as tmp:
+            result, posted, probed, _painted = self._run(Path(tmp), rows=[], dry_run=True)
+            self.assertEqual((posted, probed), ([], []))
+            self.assertEqual(result["jobs"][0]["status"], "planned")  # type: ignore[index]
+
+    def test_a_host_that_cannot_list_loras_is_not_blocked(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            result, posted, _probed, _painted = self._run(Path(tmp), rows=None)
+            self.assertEqual(result["jobs"][0]["status"], "ok")  # type: ignore[index]
+            self.assertEqual(len(posted), 1)
+
+    def test_a_job_without_lora_tags_is_never_blocked(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            result, posted, _probed, _painted = self._run(Path(tmp), rows=[], job=_job(prompt="1girl, solo"))
+            self.assertEqual(result["jobs"][0]["status"], "ok")  # type: ignore[index]
+            self.assertEqual(len(posted), 1)
+
+    def test_the_returned_picture_is_checked_for_applied_loras(self) -> None:
+        known = [{"name": "caststyle_xl_epoch08"}, {"name": "nieva_xl"}, {"name": "extra"}]
+        with tempfile.TemporaryDirectory() as tmp:
+            result, _posted, _probed, _painted = self._run(Path(tmp), rows=known, parameters=INFOTEXT)
+            row = result["jobs"][0]  # type: ignore[index]
+            self.assertTrue(any(note.startswith("lora_not_applied") for note in row["warnings"]))
+        hashes = INFOTEXT + ', Lora hashes: "caststyle_xl_epoch08: 1, nieva_xl: 2, extra: 3"'
+        with tempfile.TemporaryDirectory() as tmp:
+            result, _posted, _probed, _painted = self._run(Path(tmp), rows=known, parameters=hashes)
+            self.assertEqual(result["jobs"][0]["warnings"], [])  # type: ignore[index]
+        with tempfile.TemporaryDirectory() as tmp:
+            result, _posted, _probed, _painted = self._run(Path(tmp), rows=known, parameters=None)
+            self.assertEqual(result["jobs"][0]["warnings"], [])  # type: ignore[index]
+
+    def test_the_ledger_keeps_what_was_asked_and_what_came_back(self) -> None:
+        known = [{"name": "caststyle_xl_epoch08"}, {"name": "nieva_xl"}, {"name": "extra"}]
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            self._run(root, rows=known, parameters=INFOTEXT)
+            ledger = json.loads((root / "diffs" / "pipeline.json").read_text(encoding="utf-8"))["items"]
+            row = next(iter(ledger.values()))
+            self.assertEqual(row["lora"]["asked"], ["caststyle_xl_epoch08", "nieva_xl", "extra"])
+            self.assertEqual(row["lora"]["applied"], [])
+            self.assertEqual(len(row["lora"]["not_applied"]), 3)
+
+    def test_a_bad_mode_is_refused(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            with self.assertRaises(DiffSetError):
+                self._run(Path(tmp), rows=[], mode="maybe")
+
+
+if __name__ == "__main__":
+    unittest.main()
