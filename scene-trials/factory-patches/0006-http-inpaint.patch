diff --git a/sd-diff-set/sd_diff_set/http_inpaint.py b/sd-diff-set/sd_diff_set/http_inpaint.py
new file mode 100644
index 0000000..5e03c62
--- /dev/null
+++ b/sd-diff-set/sd_diff_set/http_inpaint.py
@@ -0,0 +1,160 @@
+"""Inpaint through the WebUI HTTP API.
+
+The external CLI does not run inside reForge, so ``modules.processing`` cannot
+be imported there. This host posts one ``/sdapi/v1/img2img`` per stage to the
+same API base the txt2img jobs use. The prompt, including ``<lora:...>``, is
+the body. Scripts that are not listed keep their defaults and still run.
+"""
+
+from __future__ import annotations
+
+import base64
+import io
+import json
+import urllib.error
+import urllib.request
+from pathlib import Path
+
+from PIL import Image
+
+from sd_diff_set.api_payload import build_img2img_payload
+from sd_diff_set.errors import DiffSetError
+from sd_diff_set.executor import GenerationHost, InpaintJob
+from sd_diff_set.host import _append_lora_hashes, _lora_hashes, lock_unmasked_rgb
+from sd_diff_set.infotext import Infotext
+from sd_diff_set.png_text import upsert_parameters
+from sd_diff_set.prompt_edit import extra_network_tags
+
+
+class HttpInpaintHost(GenerationHost):
+    """One inpaint is one POST. The masked pixels come back; the rest stay the init image."""
+
+    def __init__(self, api_base: str, timeout: float = 600) -> None:
+        text = api_base.strip()
+        if not text:
+            raise DiffSetError("inpaint_http", "inpaint の API アドレスが空です。")
+        self.api_base = text.rstrip("/")
+        self.timeout = timeout
+
+    def inpaint(self, job: InpaintJob) -> None:
+        if job.use_controlnet and any(unit.get("enabled") for unit in job.controlnet):
+            raise DiffSetError(
+                "controlnet_http_unsupported",
+                "HTTP の inpaint は ControlNet を送りません。ControlNet を切って実行してください。",
+            )
+        payload = _payload(job)
+        image, info = _post_img2img(self.api_base, payload, self.timeout)
+        _write(job, image, info)
+
+
+def _payload(job: InpaintJob) -> dict[str, object]:
+    info = Infotext(
+        prompt=job.prompt,
+        negative_prompt=job.negative_prompt,
+        seed=job.seed,
+        sampler=job.sampler,
+        scheduler=job.scheduler,
+        steps=job.steps,
+        cfg_scale=job.cfg_scale,
+        width=job.width,
+        height=job.height,
+        model=job.model,
+        model_hash=job.model_hash,
+        vae=job.vae,
+        clip_skip=job.clip_skip,
+        raw="",
+    )
+    body = build_img2img_payload(
+        info=info,
+        prompt=job.prompt,
+        negative_prompt=job.negative_prompt,
+        init_image_base64=_png_b64(job.init_path),
+        mask_base64=_png_b64(job.mask_path),
+        denoise=job.denoise,
+        mask_blur=job.mask_blur,
+        inpainting_fill=job.inpainting_fill,
+        inpaint_full_res=job.inpaint_full_res,
+        padding=job.padding,
+        width=job.width,
+        height=job.height,
+        soft_inpainting=job.soft_inpainting,
+    )
+    if job.scheduler is None:
+        body.pop("scheduler", None)
+    return body
+
+
+def _png_b64(path: Path) -> str:
+    return base64.b64encode(path.read_bytes()).decode("ascii")
+
+
+def _post_img2img(api_base: str, payload: dict[str, object], timeout: float) -> tuple[bytes, str]:
+    url = api_base.rstrip("/") + "/sdapi/v1/img2img"
+    request = urllib.request.Request(
+        url,
+        data=json.dumps(payload).encode("utf-8"),
+        headers={"Content-Type": "application/json"},
+    )
+    try:
+        with urllib.request.urlopen(request, timeout=timeout) as response:
+            data = json.loads(response.read().decode("utf-8"))
+    except urllib.error.HTTPError as exc:
+        detail = exc.read()[:300].decode("utf-8", "replace")
+        raise DiffSetError("inpaint_http", f"img2img が {exc.code} を返しました。{detail}") from exc
+    except urllib.error.URLError as exc:
+        raise DiffSetError("inpaint_http", f"img2img に届きません。{exc.reason}") from exc
+    except (TimeoutError, json.JSONDecodeError) as exc:
+        raise DiffSetError("inpaint_http", f"img2img の応答を読めません。{exc}") from exc
+    images = data.get("images") if isinstance(data, dict) else None
+    if not isinstance(images, list) or not images:
+        raise DiffSetError("output_missing", "img2img が画像を返しませんでした。")
+    encoded = str(images[0])
+    if encoded.startswith("data:") and "," in encoded:
+        encoded = encoded.split(",", 1)[1]
+    return base64.b64decode(encoded), _info_text(data.get("info") if isinstance(data, dict) else None)
+
+
+def _info_text(info: object) -> str:
+    if isinstance(info, str):
+        try:
+            info = json.loads(info)
+        except json.JSONDecodeError:
+            return info
+    if isinstance(info, dict):
+        texts = info.get("infotexts")
+        if isinstance(texts, list) and texts:
+            return str(texts[0])
+    return ""
+
+
+def _write(job: InpaintJob, raw: bytes, info: str) -> None:
+    try:
+        with Image.open(io.BytesIO(raw)) as image:
+            result = image.convert("RGB")
+    except OSError as exc:
+        raise DiffSetError("inpaint_http", f"img2img の画像を開けません。{exc}") from exc
+    with Image.open(job.init_path) as image:
+        init = image.convert("RGB")
+    if job.lock_unmasked:
+        if result.size != init.size:
+            raise DiffSetError(
+                "output_missing",
+                f"img2img のサイズが元画像と違います。返却 {result.size[0]}x{result.size[1]}、"
+                f"元 {init.size[0]}x{init.size[1]}。",
+            )
+        with Image.open(job.mask_path) as image:
+            mask = image.convert("L")
+        if mask.size != init.size:
+            resample = getattr(Image, "Resampling", Image).NEAREST
+            mask = mask.resize(init.size, resample)
+        locked = lock_unmasked_rgb(init.tobytes(), result.tobytes(), mask.tobytes())
+        result = Image.frombytes("RGB", init.size, locked)
+    job.dest.parent.mkdir(parents=True, exist_ok=True)
+    result.save(job.dest)
+    hashes = _lora_hashes([info])
+    if extra_network_tags(job.prompt) and not hashes:
+        print(
+            "LoRA タグは inpaint のプロンプトに入れましたが、返った画像に Lora hashes がありません: "
+            + ", ".join(extra_network_tags(job.prompt))
+        )
+    upsert_parameters(job.dest, _append_lora_hashes(job.parameters_text, hashes))
