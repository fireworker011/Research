diff --git a/sd-diff-set/tests/test_http_inpaint.py b/sd-diff-set/tests/test_http_inpaint.py
new file mode 100644
index 0000000..3c1f317
--- /dev/null
+++ b/sd-diff-set/tests/test_http_inpaint.py
@@ -0,0 +1,320 @@
+"""External inpaint goes through /sdapi/v1/img2img. No GPU and no reForge process."""
+
+from __future__ import annotations
+
+import base64
+import json
+import sys
+import tempfile
+import threading
+import unittest
+from dataclasses import replace
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from PIL import Image
+
+from sd_diff_set.cli import main
+from sd_diff_set.errors import DiffSetError
+from sd_diff_set.executor import InpaintJob
+from sd_diff_set.factory_line import run_factory
+from sd_diff_set.http_inpaint import HttpInpaintHost
+from sd_diff_set.pipeline import Pipeline, PipelineSettings
+from sd_diff_set.png_text import read_parameters, write_l_png, write_rgb_png
+from sd_diff_set.router import route_file
+
+PRESETS = Path(__file__).resolve().parents[1] / "presets"
+LORA = "<lora:caststyle_xl_epoch08:0.9>"
+
+
+def _settings(root: Path, **overrides: object) -> PipelineSettings:
+    values: dict[str, object] = {
+        "inbox": root / "inbox",
+        "sorted_dir": root / "sorted",
+        "output_dir": root / "diffs",
+        "preset_dir": PRESETS,
+        "adult_ok": True,
+        "dry_run": True,
+        "limbs": False,
+    }
+    values.update(overrides)
+    return PipelineSettings(**values)  # type: ignore[arg-type]
+
+
+def _job(root: Path, **overrides: object) -> InpaintJob:
+    init = root / "init.png"
+    mask = root / "mask.png"
+    write_rgb_png(init, 4, 2, (255, 0, 0))
+    write_l_png(mask, 4, 2, bytes([255, 255, 0, 0, 255, 255, 0, 0]))
+    job = InpaintJob(
+        init_path=init,
+        mask_path=mask,
+        dest=root / "out.png",
+        prompt=f"1girl, {LORA}, simple background",
+        negative_prompt="lowres",
+        seed=3,
+        sampler="Euler a",
+        scheduler=None,
+        steps=28,
+        cfg_scale=6.0,
+        width=4,
+        height=2,
+        denoise=0.55,
+        mask_blur=0,
+        inpainting_fill=1,
+        inpaint_full_res=True,
+        padding=32,
+        model="demo.safetensors",
+        model_hash=None,
+        vae=None,
+        clip_skip=2,
+        parameters_text="1girl, kept",
+        controlnet=[],
+        soft_inpainting=False,
+        use_controlnet=False,
+        base_path=init,
+        lock_unmasked=True,
+    )
+    return replace(job, **overrides) if overrides else job
+
+
+class _Handler(BaseHTTPRequestHandler):
+    def do_POST(self) -> None:  # noqa: N802
+        length = int(self.headers.get("Content-Length") or 0)
+        body = json.loads(self.rfile.read(length).decode("utf-8"))
+        server = self.server
+        assert isinstance(server, _Server)
+        server.captured.append((self.path, body))
+        if server.status != 200:
+            raw = b"nope"
+            self.send_response(server.status)
+            self.send_header("Content-Length", str(len(raw)))
+            self.end_headers()
+            self.wfile.write(raw)
+            return
+        payload = json.dumps({"images": server.images, "info": json.dumps({"infotexts": [server.info]})}).encode()
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(payload)))
+        self.end_headers()
+        self.wfile.write(payload)
+
+    def log_message(self, format: str, *args: object) -> None:
+        return
+
+
+class _Server(ThreadingHTTPServer):
+    def __init__(self) -> None:
+        super().__init__(("127.0.0.1", 0), _Handler)
+        self.captured: list[tuple[str, dict[str, object]]] = []
+        self.images: list[str] = []
+        self.info = ""
+        self.status = 200
+
+
+class Server:
+    def __init__(self) -> None:
+        self.httpd = _Server()
+        self.thread = threading.Thread(target=self.httpd.serve_forever, daemon=True)
+
+    def __enter__(self) -> _Server:
+        self.thread.start()
+        return self.httpd
+
+    def __exit__(self, *exc: object) -> None:
+        self.httpd.shutdown()
+        self.thread.join(3)
+        self.httpd.server_close()
+
+
+def _png_b64(path: Path) -> str:
+    return base64.b64encode(path.read_bytes()).decode("ascii")
+
+
+class HttpInpaintTests(unittest.TestCase):
+    def test_img2img_keeps_the_lora_tag_and_the_unmasked_pixels(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            blue = root / "blue.png"
+            write_rgb_png(blue, 4, 2, (0, 0, 255))
+            job = _job(root)
+            with Server() as server:
+                server.images = ["data:image/png;base64," + _png_b64(blue)]
+                server.info = '1girl\nSteps: 28, Lora hashes: "caststyle_xl_epoch08: ab12cd"'
+                api = f"http://{server.server_address[0]}:{server.server_address[1]}"
+                HttpInpaintHost(api).inpaint(job)
+            path, body = server.captured[0]
+            self.assertEqual(path, "/sdapi/v1/img2img")
+            self.assertIn(LORA, str(body["prompt"]))
+            self.assertNotIn("scheduler", body)
+            self.assertIn("Soft Inpainting", body["alwayson_scripts"])  # type: ignore[index]
+            with Image.open(job.dest) as image:
+                pixels = list(image.convert("RGB").get_flattened_data())
+            self.assertEqual(pixels[0], (0, 0, 255))
+            self.assertEqual(pixels[2], (255, 0, 0))
+            saved = read_parameters(job.dest) or ""
+            self.assertIn("1girl, kept", saved)
+            self.assertIn("caststyle_xl_epoch08: ab12cd", saved)
+
+    def test_a_failed_post_and_an_empty_reply_are_errors(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            job = _job(root)
+            with Server() as server:
+                api = f"http://{server.server_address[0]}:{server.server_address[1]}"
+                server.status = 500
+                with self.assertRaises(DiffSetError) as failed:
+                    HttpInpaintHost(api).inpaint(job)
+                self.assertEqual(failed.exception.code, "inpaint_http")
+                server.status = 200
+                server.images = []
+                with self.assertRaises(DiffSetError) as empty:
+                    HttpInpaintHost(api).inpaint(job)
+                self.assertEqual(empty.exception.code, "output_missing")
+
+    def test_controlnet_is_refused_instead_of_dropped(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            job = _job(Path(tmp), use_controlnet=True, controlnet=[{"enabled": True}])
+            with self.assertRaises(DiffSetError) as caught:
+                HttpInpaintHost("http://127.0.0.1:9").inpaint(job)
+            self.assertEqual(caught.exception.code, "controlnet_http_unsupported")
+
+
+class WiringTests(unittest.TestCase):
+    def test_a_real_run_points_inpaint_at_the_chosen_api(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            image = root / "ret.png"
+            write_rgb_png(image, 8, 8)
+            data = image.read_bytes()
+
+            def paint(**_kwargs: object) -> dict[str, object]:
+                return {"status": "ok", "items": [], "dry_run": False}
+
+            local = run_factory(
+                settings=_settings(root, dry_run=False),
+                jobs=[{"id": "pic", "prompt": "1girl", "negative_prompt": "lowres", "sampler_name": "Euler a", "steps": 1, "cfg_scale": 1, "width": 8, "height": 8, "model": "m", "stages": ["none"]}],
+                poster=lambda _api, _payload: data,
+                dry_run=False,
+                once=True,
+                run_job=paint,
+                lora_check="off",
+                use_http_inpaint=True,
+            )
+            self.assertEqual(local["pipeline"].settings.inpaint_api, "http://127.0.0.1:7860")  # type: ignore[index]
+            colab = run_factory(
+                settings=_settings(root, dry_run=False),
+                jobs=[{"id": "pic", "prompt": "1girl", "negative_prompt": "lowres", "sampler_name": "Euler a", "steps": 1, "cfg_scale": 1, "width": 8, "height": 8, "model": "m", "stages": ["none"]}],
+                colab_api="https://example.gradio.live/",
+                probe=lambda _api: {"status": 200, "free_mib": 20000, "busy": False},
+                poster=lambda _api, _payload: data,
