+def script_kept(title: str, filename: str = "", *, controlnet: bool, soft: bool) -> bool:
+    """Which always-on scripts an inpaint may run.
+
+    ADetailer, Regional Prompter and Dynamic Prompts would run a second time on
+    top of the factory's own mask, so they stay off. ControlNet and Soft
+    Inpainting run only when the job asked for them. A script that applies
+    LoRA or extra networks stays, which is what a manual inpaint runs.
+    """
+    text = f"{title}\n{filename}".casefold()
+    if any(mark in text for mark in _DROPPED_SCRIPT_MARKS):
+        return False
+    if "controlnet" in text or "control net" in text:
+        return controlnet
+    if "soft inpaint" in text:
+        return soft
+    return any(mark in text for mark in ("lora", "lyco", "extra network", "extra_network"))
+
+
+def inpaint_processing_fields(job: InpaintJob) -> dict[str, Any]:
+    """The values handed to the inpaint call. The prompt is the stage prompt, unchanged."""
+    fields: dict[str, Any] = {
+        "resize_mode": 0,
+        "denoising_strength": job.denoise,
+        "mask_blur": job.mask_blur,
+        "inpainting_fill": job.inpainting_fill,
+        "inpaint_full_res": job.inpaint_full_res,
+        "inpaint_full_res_padding": job.padding,
+        "inpainting_mask_invert": 0,
+        "prompt": job.prompt,
+        "negative_prompt": job.negative_prompt,
+        "seed": job.seed,
+        "subseed": -1,
+        "subseed_strength": 0,
+        "seed_resize_from_h": -1,
+        "seed_resize_from_w": -1,
+        "sampler_name": job.sampler,
+        "batch_size": 1,
+        "n_iter": 1,
+        "steps": job.steps,
+        "cfg_scale": job.cfg_scale,
+        "width": job.width,
+        "height": job.height,
+        "restore_faces": False,
+        "tiling": False,
+        "do_not_save_samples": True,
+        "do_not_save_grid": True,
+        "override_settings": _override_settings(job),
+    }
+    if job.scheduler:
+        fields["scheduler"] = job.scheduler
+    return fields
+
+
+def _force_lora_reload() -> None:
+    """Make reForge load the prompt's LoRA instead of reusing the previous one.
+
+    load_networks returns immediately when the name list matches the last call, and
+    img2img then samples from forge_objects_after_applying_lora. Clearing the hash
+    makes this inpaint build that object from the prompt again.
+    """
+    if webui_shared is None:
+        return
+    model = getattr(webui_shared, "sd_model", None)
+    if model is not None and hasattr(model, "current_lora_hash"):
+        model.current_lora_hash = None
+
+
+def _lora_hashes(infotexts: object) -> str:
+    if not isinstance(infotexts, list):
+        return ""
+    for item in infotexts:
+        match = _LORA_HASHES.search(str(item))
+        if match:
+            return match.group(1).strip()
+    return ""
+
+
+def _append_lora_hashes(parameters: str, hashes: str) -> str:
+    if not hashes or "Lora hashes:" in parameters:
+        return parameters
+    return parameters + f', Lora hashes: "{hashes}"'
 
 
