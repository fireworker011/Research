@@ -0,0 +1,124 @@
+"""Inpaint keeps the prompt's LoRA tags and does not switch extra networks off. No GPU."""
+
+from __future__ import annotations
+
+import sys
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from sd_diff_set.api_payload import build_img2img_payload
+from sd_diff_set.executor import InpaintJob
+from sd_diff_set.host import (
+    _append_lora_hashes,
+    _lora_hashes,
+    inpaint_processing_fields,
+    script_kept,
+)
+from sd_diff_set.infotext import Infotext
+
+LORA = "<lora:caststyle_xl_epoch08:0.9>"
+
+
+def _job() -> InpaintJob:
+    return InpaintJob(
+        init_path=Path("init.png"),
+        mask_path=Path("mask.png"),
+        dest=Path("out.png"),
+        prompt=f"1girl, {LORA}, simple background",
+        negative_prompt="lowres",
+        seed=3,
+        sampler="Euler a",
+        scheduler=None,
+        steps=28,
+        cfg_scale=6.0,
+        width=1024,
+        height=1344,
+        denoise=0.55,
+        mask_blur=0,
+        inpainting_fill=1,
+        inpaint_full_res=True,
+        padding=32,
+        model="demo.safetensors",
+        model_hash=None,
+        vae=None,
+        clip_skip=2,
+        parameters_text="prompt",
+        controlnet=[],
+        soft_inpainting=False,
+        use_controlnet=False,
+        base_path=Path("base.png"),
+    )
+
+
+class ScriptFilterTests(unittest.TestCase):
+    def test_lora_scripts_stay_and_the_double_painters_go(self) -> None:
+        self.assertTrue(script_kept("LoRA", "extensions-builtin/Lora/scripts/lora_script.py", controlnet=False, soft=False))
+        self.assertTrue(script_kept("Extra networks", "", controlnet=False, soft=False))
+        self.assertFalse(script_kept("ADetailer", "extensions/adetailer/scripts/adetailer.py", controlnet=True, soft=True))
+        self.assertFalse(script_kept("Regional Prompter", "", controlnet=False, soft=False))
+        self.assertFalse(script_kept("Dynamic Prompts", "", controlnet=False, soft=False))
+        self.assertFalse(script_kept("ControlNet", "", controlnet=False, soft=False))
+        self.assertTrue(script_kept("ControlNet", "", controlnet=True, soft=False))
+        self.assertFalse(script_kept("Soft Inpainting", "", controlnet=False, soft=False))
+        self.assertTrue(script_kept("Soft Inpainting", "", controlnet=False, soft=True))
+        self.assertFalse(script_kept("advanced model sampling for reforge", "", controlnet=False, soft=False))
+
+
+class InpaintFieldsTests(unittest.TestCase):
+    def test_the_stage_prompt_is_the_inpaint_prompt(self) -> None:
+        fields = inpaint_processing_fields(_job())
+        self.assertIn(LORA, fields["prompt"])
+        self.assertEqual(
+            set(fields["override_settings"]),
+            {"sd_model_checkpoint", "CLIP_stop_at_last_layers"},
+        )
+        self.assertNotIn("sd_lora", fields["override_settings"])
+        self.assertNotIn("disable_extra_networks", fields)
+
+    def test_hashes_from_the_webui_are_kept_on_the_saved_text(self) -> None:
+        found = _lora_hashes(['1girl\nSteps: 20, Lora hashes: "caststyle_xl_epoch08: ab12cd"'])
+        self.assertEqual(found, "caststyle_xl_epoch08: ab12cd")
+        self.assertEqual(_lora_hashes(["Steps: 20"]), "")
+        saved = _append_lora_hashes("1girl", found)
+        self.assertIn('Lora hashes: "caststyle_xl_epoch08: ab12cd"', saved)
+        self.assertEqual(_append_lora_hashes(saved, found), saved)
+
+    def test_http_payload_also_keeps_the_tag(self) -> None:
+        info = Infotext(
+            prompt="1girl",
+            negative_prompt="lowres",
+            seed=1,
+            sampler="Euler a",
+            scheduler=None,
+            steps=20,
+            cfg_scale=7.0,
+            width=64,
+            height=64,
+            model="demo",
+            model_hash=None,
+            vae=None,
+            clip_skip=2,
+            raw="",
+        )
+        payload = build_img2img_payload(
+            info=info,
+            prompt=f"1girl, {LORA}",
+            negative_prompt="lowres",
+            init_image_base64="a",
+            mask_base64="b",
+            denoise=0.5,
+            mask_blur=0,
+            inpainting_fill=1,
+            inpaint_full_res=True,
+            padding=32,
+            width=64,
+            height=64,
+        )
+        self.assertIn(LORA, payload["prompt"])
+        self.assertNotIn("sd_lora", payload["override_settings"])
+
+
+if __name__ == "__main__":
+    unittest.main()
